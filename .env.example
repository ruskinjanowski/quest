# Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-32-char-or-longer-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Canonical site URL (used for metadata and auth callbacks in production).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seeded demo account — credentials typed on camera during the Loom.
DEMO_USER_EMAIL="demo@quest.app"
DEMO_USER_PASSWORD="questdemo123"

# Allow the public "Reset demo data" action on the deployed prototype.
ALLOW_DEMO_RESET="true"
